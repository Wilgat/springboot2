# =============================================================================

app_about() {
    if [ "${JSON}" -eq 1 ]; then
        # === JSON MODE - Clean machine output ===
        local installed="false"
        inst_is_installed && installed="true"

        local sdkman_status="not found"
        [ -d "${HOME}/.sdkman" ] && sdkman_status="installed"

        local java_version="not found"
        if command -v java >/dev/null 2>&1; then
            java_version=$(java -version 2>&1 | head -n 1 | tr -d '\n\r')
        fi

        local maven_version="not found"
        if command -v mvn >/dev/null 2>&1; then
            maven_version=$(mvn --version | head -n 1 | tr -d '\n\r')
        fi

        local project_exists="false"
        [ -d "${PROJECT_DIR}" ] && project_exists="true"

        local app_running="false"
        if command -v ss >/dev/null 2>&1 && ss -tuln 2>/dev/null | grep -q ":${PORT}"; then
            app_running="true"
        elif command -v netstat >/dev/null 2>&1 && netstat -tuln 2>/dev/null | grep -q ":${PORT}"; then
            app_running="true"
        fi

        # Resolve storage if main has not yet (defensive)
        if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
            EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
        fi
        : "${STORAGE_DIR:=${XDG_CACHE_HOME:-${HOME}/.cache}/${APP_NAME}-${USERNAME}}"

        # Clean JSON output - no generic message
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "installed" "${installed}" \
            "sdkman" "${sdkman_status}" \
            "java" "${java_version}" \
            "maven" "${maven_version}" \
            "project_dir" "${PROJECT_DIR}" \
            "project_exists" "${project_exists}" \
            "port" "${PORT}" \
            "app_running" "${app_running}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "user" "${USERNAME}" \
            "shell" "$(ps -p $$ -o comm= 2>/dev/null | tr -d '()')"

        return 0
    fi

    # === HUMAN-READABLE MODE ===
    [ "${QUIET}" -eq 1 ] && return 0

    out_plain "=== ${APP_NAME} ${VERSION} - Full Diagnostics ==="
    out_empty_line

    if inst_is_installed; then
        out_success "${APP_NAME} is installed at ${INSTALL_PATH}"
    else
        out_warn "${APP_NAME} is NOT installed."
    fi

    out_empty_line

    # SDKMAN
    if [ -d "${HOME}/.sdkman" ]; then
        out_success "SDKMAN     : installed"
    else
        out_warn "SDKMAN     : not found"
    fi

    # Java
    if command -v java >/dev/null 2>&1; then
        out_plain "Java       : $(java -version 2>&1 | head -n 1)"
    else
        out_warn "Java       : not found"
    fi

    # Maven
    if command -v mvn >/dev/null 2>&1; then
        out_plain "Maven      : $(mvn --version | head -n 1)"
    else
        out_warn "Maven      : not found"
    fi

    # Project
    if [ -d "${PROJECT_DIR}" ]; then
        out_success "Project    : ${PROJECT_DIR} (exists)"
    else
        out_warn "Project    : ${PROJECT_DIR} (does not exist)"
    fi

    # Scratch/cache storage (not project dir)
    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    out_plain "Storage    : ${EFFECTIVE_STORAGE_DIR} (effective)"
    out_plain "Cache fall.: ${STORAGE_DIR:-n/a}"

    # App running status
    local running_status="no"
    if command -v ss >/dev/null 2>&1 && ss -tuln 2>/dev/null | grep -q ":${PORT}"; then
        running_status="yes"
    elif command -v netstat >/dev/null 2>&1 && netstat -tuln 2>/dev/null | grep -q ":${PORT}"; then
        running_status="yes"
    fi
    out_plain "App on port ${PORT} : ${running_status}"

    out_empty_line
    out_plain "Use '${APP_NAME} about --json' for machine-readable output."
