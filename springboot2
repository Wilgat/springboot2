    out_plain "  ${APP_NAME} status                   Diagnostics (alias of about)"
    out_plain "  ${APP_NAME} about                    Full diagnostics"
    out_plain "  ${APP_NAME} version                  Local CLI version"
    out_plain "  ${APP_NAME} version-check            Compare CLI with remote channel"
    out_plain "  ${APP_NAME} self-update              Update the CLI ship unit (alias: self-upgrade)"
    out_plain "  ${APP_NAME} self-uninstall           Remove the CLI binary only"
    out_plain "  ${APP_NAME} reinstall                Force reinstall CLI then payload setup"
    out_plain "  ${APP_NAME} help                     This help"
    out_plain ""
    out_plain "Command layers:"
