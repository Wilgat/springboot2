}

# =============================================================================
# payload_install() — ensure Spring Boot environment payload (not the CLI binary)
# =============================================================================
# requirement-shell-payload-online-install.md: `install` = payload only.
# =============================================================================
payload_install() {
    : "${NO_RUN:=1}"
    : "${PROJECT_DIR:=${HOME}/springboot-${APP_NAME}}"
    : "${JSON:=0}"

    out_info "Payload install: ensuring SDKMAN / Java / Maven / project..."
    check_alpine_requirements || return 1
    setup_sdkman || return 1
    setup_java || return 1
    setup_maven || return 1
    setup_springboot_project || return 1

    if [ "${JSON}" -eq 1 ]; then
        out_json "out_success" "" \
            "message" "Payload environment and project ready" \
            "project_dir" "${PROJECT_DIR}" \
            "layer" "payload"
    else
        out_success "Payload installed (environment + project)."
        out_success "Project location: ${PROJECT_DIR}"
        out_info "CLI ship unit is unchanged (use self-update / self-uninstall for the script)."
    fi
    return 0
}

# =============================================================================
# payload_uninstall() — remove managed project payload only (not the CLI)
# =============================================================================
payload_uninstall() {
    : "${PROJECT_DIR:=${HOME}/springboot-${APP_NAME}}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"

    if [ "${FORCE}" -eq 1 ]; then
        FORCE_REINSTALL=1
    fi

    if [ ! -d "${PROJECT_DIR}" ]; then
        if [ "${JSON}" -eq 1 ]; then
            out_json "out_success" "Payload project not present. Nothing to uninstall." \
                "project_dir" "${PROJECT_DIR}" "layer" "payload"
        else
            out_success "Payload project not present at ${PROJECT_DIR}. Nothing to uninstall."
        fi
        return 0
    fi

    if [ "${FORCE_REINSTALL:-0}" -eq 0 ] && [ "${FORCE:-0}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ]; then
            out_json_error "Confirmation required to remove payload project ${PROJECT_DIR}" "confirm_required"
        else
            out_error "Refusing to remove payload project without --force: ${PROJECT_DIR}"
            out_info "Run: ${APP_NAME} uninstall --force"
        fi
        return 1
    fi

    if ! rm -rf "${PROJECT_DIR}"; then
        if [ "${JSON}" -eq 1 ]; then
            out_json_error "Failed to remove payload project ${PROJECT_DIR}" "io_error"
        else
            out_error "Failed to remove payload project: ${PROJECT_DIR}"
        fi
        return 1
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "out_success" "Payload project removed." \
            "project_dir" "${PROJECT_DIR}" "layer" "payload"
    else
        out_success "Payload project removed: ${PROJECT_DIR}"
        out_info "CLI binary was not removed (use self-uninstall for the script)."
    fi
    return 0
}


# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Thin dispatcher for the selfmanaged CLI (Type 0 only).
# Handles:
#   - Auto-install behavior for classic `curl | sh` one-liner (zero arguments)
#   - Global flag parsing (--quiet, --json, --debug, --force)
#   - Command routing for all Type 0 self-management commands
#
# This is the single entry point when the script is executed directly.
#
# CIAO PRINCIPLES APPLIED:
# - Caution (Principle 1): Never call undefined functions. Always use inst_is_installed.
#   Auto-install block is kept at the very top as required by existing comments.
# - Intentional (Principle 2): All supported commands from
#   requirement-shell-cli-interface.md and app_help() are recognized and routed.
# - Anti-fragile (Principle 3): Works correctly in interactive TTY, quiet, JSON,
#   and non-interactive `curl | sh` environments.
# - Over-protect (Principle 18): Explicit if/then logic, safe defaults, and centralized
#   output via out_die for unknown commands.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This is the central command dispatcher. Changes here affect every execution path.
#
# Lessons Learned (CIAO Reflection):
# 2026-06-26:
#   - Original version called non-existent functions and only recognized
#     version/about/help; expanded routing and safe defaults.
# 2026-07-12:
#   - Wired --force → FORCE=1 and FORCE_REINSTALL=1 (requirement-shell-cli-interface).
# 2026-07-14:
#   - version routes through app_version (no dual inline path).
#   - zero-arg install propagates failure exit status.
#   - Type O empty argv: always install-ensure (not help when already installed).
#     Cases A/B/C (not installed / local / global). --force only for deliberate
#     re-download/replace — not required for a second one-liner run.
#     SSOT: requirement-shell-cli-zero-arguments.md (selfmanaged = Type O).
#
# Last reviewed: 2026-07-14
# =============================================================================

app_main() {
    # Safe defaults (repeated on purpose - defensive style)
    : "${HOME:=/root}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${PROJECT_DIR:=${HOME}/springboot-${APP_NAME}}"
    : "${NO_RUN:=0}"
    : "${RESET_PROJECT:=0}"

    # <<< IMPORTANT: Source user shell configuration >>>
    # This must happen early so that PATH, SDKMAN, and user environment
    # are available for ALL sub-commands (about, run, version-check, etc.)
    util_source_user_shell_config

    # Effective scratch/cache root for this run (requirement-shell-cli-storage)
    # Priority: /dev/shm → /tmp → STORAGE_DIR (persistent cache fallback).
    # Resolver creates root fail-closed. Export TMPDIR so mktemp -t (install
    # download stage, atomic helpers) lands under the isolated product root.
    : "${USERNAME:=unknown}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    local cmd="run"
    local empty_argv=0
    if [ $# -eq 0 ]; then
        empty_argv=1
    fi

    # === Type O-P EMPTY ARGV (payload online installer) ===
    # Ship-unit ensure first (never exit after binary-only success).
    # Non-interactive when already installed: self-update policy (already-latest OK).
    # Then fall through to payload default (cmd=run) unless later flags change cmd.
    # SSOT: requirement-shell-payload-online-install.md + requirement-shell-cli-zero-arguments.md
    if [ "${empty_argv}" -eq 1 ]; then
        if ! inst_is_installed; then
            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
                if ! inst_perform_install; then
                    exit 1
                fi
            else
                if ! inst_maybe_install; then
                    exit 1
                fi
            fi
            # continue to payload — do not exit after ship-unit place
        else
            # Non-interactive re-run: upgrade ship unit when channel says so
            if [ ! -t 0 ] || [ ! -t 1 ] || [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
                inst_self_update || true
                # inst_self_update returns non-zero on refuse-downgrade / network;
                # network fail should not block payload when binary already works —
                # but refuse-downgrade is success path (non-zero only on hard fail).
                # Re-check: if self-update hard-failed with missing channel, continue payload.
            fi
        fi
        cmd="run"
    fi

    # === FLAG-FIRST ARGUMENT PARSING (consistent with pomo style) ===
    while [ $# -gt 0 ]; do
        case "$1" in
            --project-dir)
                if [ -z "$2" ]; then
                    out_die "--project-dir requires a path"
                fi
                PROJECT_DIR="$2"
                shift
                ;;
            --no-run)
                NO_RUN=1
                ;;
            --quiet|-q)     QUIET=1 ;;
            --json)         JSON=1; QUIET=1 ;;
            --force)        FORCE=1; FORCE_REINSTALL=1 ;;
            --force-user)   FORCE_USER=1 ;;
            --force-root)   FORCE_ROOT=1; FORCE_GLOBAL=1 ;;
            --reset)        FORCE_REINSTALL=1; RESET_PROJECT=1 ;;
            --help|-h)      cmd="help";;
            --*)            ;;
            -*)             ;;
            *)              cmd="$1" ;;
        esac
        shift
    done

    # === Command Dispatch ===
    # Payload: install | uninstall | run | reinstall
    # Ship unit: self-update | self-upgrade | self-uninstall | version-check
    case "${cmd}" in
        version)
            if [ "${JSON}" -eq 1 ]; then
                out_json "version" "" "app" "${APP_NAME}" "version" "${VERSION}"
            else
                out_plain "${APP_NAME} version ${VERSION}"
            fi
            exit 0
            ;;

        version-check)
            ver_check
            exit $?
            ;;

        self-update|self-upgrade)
            inst_self_update
            exit $?
            ;;

        self-uninstall)
            inst_self_uninstall
            exit $?
            ;;

        install)
            # Payload ensure only (not ship-unit download)
            payload_install
            exit $?
            ;;

        uninstall)
            # Payload project remove only (not CLI binary)
            payload_uninstall
            exit $?
            ;;

        about|status)
            app_about
            exit $?
            ;;

        help)
            app_help
            exit 0
            ;;

        reinstall)
            # Force reinstall of CLI ship unit then payload pipeline
            FORCE_REINSTALL=1
            FORCE=1
            inst_perform_install || exit $?
            ;;

        run)
            ;;
        *)
            out_die "Invalid command: ${cmd}. Try: ${APP_NAME} help"
            ;;
    esac

    # === Payload pipeline (run / reinstall / empty-argv default) ===
    check_alpine_requirements || exit 1
    setup_sdkman || exit 1
    setup_java || exit 1
    setup_maven || exit 1
    setup_springboot_project || exit 1

    if [ "${NO_RUN}" -eq 1 ]; then
        if [ "${JSON}" -eq 1 ]; then
            out_json "out_success" "" \
                "message" "Environment and project setup completed" \
                "project_dir" "${PROJECT_DIR}" \
                "no_run" "true" \
                "layer" "payload"
        else
            out_success "Environment and project setup completed (--no-run)."
            out_success "Project location: ${PROJECT_DIR}"
        fi
        exit 0
    fi

    run_springboot_project
}


# =============================================================================
# BOOTSTRAP
# =============================================================================
#
# Always invoke the single dispatcher. Do NOT gate on ${0##*/} matching APP_NAME:
# under curl | sh / stdin pipe, $0 is the shell (sh/bash/…), not the product
# filename — a basename gate causes silent no-op and breaks one-liner install.
# See docs/terminologies/shell-cli-bootstrap.md and INC-20260712-001.
#
# Single-file install CLI: source-as-library is unsupported; main always runs.
# =============================================================================
app_main "$@"

