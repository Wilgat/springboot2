util_verify_download_integrity() {
    local tmp_file="$1"
    local actual expected sha_file http_code
    : "${SCRIPT_URL:=}"
    : "${CHECKSUM:=}"
    : "${JSON:=0}"
    AUTO_CHECKSUM_OK=0

    actual=$(util_sha256_file "${tmp_file}") || actual=""
    if [ -z "${actual}" ]; then
        if [ "${JSON}" -eq 1 ]; then
            out_json_error "Cannot compute SHA-256 of download (need sha256sum/shasum/openssl)" "checksum_tool_missing"
        else
            out_error "Cannot compute SHA-256 of download (need sha256sum/shasum/openssl)"
        fi
        return 1
    fi

    # Shape B: strict user pin
    if [ -n "${CHECKSUM}" ]; then
        if [ "${JSON}" -eq 0 ]; then
            out_info "Verifying download against provided CHECKSUM..."
            out_info "Expected SHA-256: ${CHECKSUM}"
            out_info "Actual SHA-256:   ${actual}"
        fi
        if [ "${CHECKSUM}" = "${actual}" ]; then
            AUTO_CHECKSUM_OK=1
            if [ "${JSON}" -eq 0 ]; then
                out_success "Checksum verification passed (user-provided CHECKSUM)."
            fi
            return 0
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json_error "Checksum verification failed (provided CHECKSUM does not match)" "checksum_mismatch"
        else
            out_error "Checksum verification failed. The downloaded file does not match the provided CHECKSUM."
        fi
        return 1
    fi

    # Shape A: companion ${SCRIPT_URL}.sha256
    if [ "${JSON}" -eq 0 ]; then
        out_info "No CHECKSUM pin → automatic integrity via companion ${SCRIPT_URL}.sha256"
        out_info "Companion link: ${SCRIPT_URL}.sha256"
    fi

    sha_file=$(mktemp -t "${APP_NAME}.sha256.XXXXXX") || {
        if [ "${JSON}" -eq 1 ]; then
            out_json_error "Failed to create temporary file for checksum" "io_error"
        else
            out_error "Failed to create temporary file for checksum"
        fi
        return 1
    }

    http_code=""
    if command -v curl >/dev/null 2>&1; then
        http_code=$(curl -fsSL -w "%{http_code}" "${SCRIPT_URL}.sha256" -o "${sha_file}" 2>/dev/null) || http_code="000"
    elif command -v wget >/dev/null 2>&1; then
        if wget -qO "${sha_file}" "${SCRIPT_URL}.sha256" 2>/dev/null; then
            http_code="200"
        else
            http_code="404"
        fi
    else
        http_code="000"
    fi

    if [ "${http_code}" = "200" ]; then
        expected=$(awk 'NF { print $1; exit }' "${sha_file}" 2>/dev/null)
        rm -f "${sha_file}" 2>/dev/null || true
        if [ -n "${expected}" ] && [ "${expected}" = "${actual}" ]; then
            AUTO_CHECKSUM_OK=1
            if [ "${JSON}" -eq 0 ]; then
                out_info "Expected SHA-256: ${expected}"
                out_info "Actual SHA-256:   ${actual}"
                out_success "Automatic checksum result: PASS (match ${SCRIPT_URL}.sha256)."
            fi
            return 0
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json_error "Automatic checksum verification failed" "checksum_mismatch"
        else
            out_info "Expected SHA-256: ${expected:-"(empty)"}"
            out_info "Actual SHA-256:   ${actual}"
            out_error "Checksum verification failed (mismatch with ${SCRIPT_URL}.sha256). Installation aborted for security."
        fi
        return 1
    fi

    rm -f "${sha_file}" 2>/dev/null || true
    if [ "${JSON}" -eq 0 ]; then
        out_warn "No .sha256 companion at ${SCRIPT_URL}.sha256 → continuing without automatic verification."
    fi
    return 0
}

